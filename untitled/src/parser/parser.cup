package parser;
//=======================================================================================================

// Para que los archivos Parser.java y sym.java se creen dentro del paquete parser.

import java.util.*;
import java_cup.runtime.*;
import codigo.CodeGenerator;

/* Aqui hacemos override a los errores que por defecto muestra cup para así
 * poder distinguir entre los tipos de errores, lo cual hace más fácil reconocer
 * los errores y seguimos la indicación sobre los errores
 */

parser code {:

  // === Tipos básicos que usaremos en semántica ===
  public static final String TYPE_INT      = "INT";
  public static final String TYPE_REAL     = "REAL";
  public static final String TYPE_STRING   = "STRING";
  public static final String TYPE_CHAR     = "CHAR";
  public static final String TYPE_UNKNOWN  = "UNKNOWN";

  // Obtener tipo de un identificador (por ahora, solo variables globales)
  public String getIdType(Object idVal) {
    if (idVal == null) return TYPE_UNKNOWN;
    String name = idVal.toString();
    String t = CodeGenerator.getInstance().getVarType(name);
    return (t != null) ? t : TYPE_UNKNOWN;
  }


  //PARA DECLARACION DE VARIABLES Y VARIABLES NO DEFINIDAS: 
    public void addSemanticError(String msg, int line) {
    String full = (line >= 0)
        ? ("Línea " + line + ": " + msg)
        : msg;
    CodeGenerator.getInstance().addSemanticError(full);
    }

  // Verificar que una variable exista (por ahora solo global)
  // idVal = value del token ID (normalmente el lexema "a", "b", etc.)
    public void checkVarDefined(Object idVal, int line) {
      if (idVal == null) return;

      String name = idVal.toString();

      if (!CodeGenerator.getInstance().isVarDefined(name)) {
        addSemanticError("Variable '" + name + "' no definida", line);
      }
    }
  
  //PARA LAS FUNCIONES Y PROCEDIMIENTOS: 

  public static class RoutineInfo {
    public boolean isProcedure;
    public java.util.List paramTypes; // lista de String ("INT", "REAL", ...)

    public RoutineInfo(boolean isProcedure, java.util.List paramTypes) {
      this.isProcedure = isProcedure;
      this.paramTypes = paramTypes;
    }
  }
  public java.util.Map<String, RoutineInfo> routines = new java.util.HashMap<>();

  // lista temporal donde acumulamos tipos de parámetros al leer el encabezado
  public java.util.List tmpParamTypes = new java.util.ArrayList();

  // Registrar una nueva FUNCTION/PROCEDURE
  public void registerRoutine(Object idVal, int line, boolean isProcedure, java.util.List paramTypes) {
    if (idVal == null) return;

    String name = idVal.toString();

    if (routines.containsKey(name)) {
      String kind = isProcedure ? "Procedimiento" : "Función";
      addSemanticError(kind + " '" + name + "' declarado más de una vez", line);
    } else {
      // Guardamos una copia de la lista de tipos de parámetros
      routines.put(name, new RoutineInfo(isProcedure, new java.util.ArrayList(paramTypes)));
    }
  }

  // Verificar que una FUNCTION/PROCEDURE exista
  public void checkRoutineDefined(Object idVal, Object argTypesObj, int line) {
    if (idVal == null) return;

    // Cast seguro a List (lo que construimos en args_opt)
    java.util.List argTypes = null;
    if (argTypesObj instanceof java.util.List) {
        argTypes = (java.util.List) argTypesObj;
    }

    String name = idVal.toString();
    RoutineInfo info = routines.get(name);

    if (info == null) {
      addSemanticError("Función o procedimiento '" + name + "' no definido", line);
      return;
    }

    // --- Cantidad ---
    int expected = (info.paramTypes == null) ? 0 : info.paramTypes.size();
    int given    = (argTypes == null)        ? 0 : argTypes.size();

    if (expected != given) {
      addSemanticError(
        "Cantidad de parámetros incorrecta en llamada a '" + name +
        "': se esperaban " + expected + " y se recibieron " + given,
        line
      );
      return;
    }

    // --- Tipos ---
    for (int i = 0; i < expected; i++) {
      String expectedType = (String) info.paramTypes.get(i);
      String actualType   = (String) argTypes.get(i);

      if (actualType == null)
        actualType = TYPE_UNKNOWN;

      if (!TYPE_UNKNOWN.equals(actualType) && !expectedType.equals(actualType)) {
        addSemanticError(
          "Tipo de parámetro " + (i + 1) + " incorrecto en llamada a '" + name +
          "': se esperaba " + expectedType + " y se recibió " + actualType,
          line
        );
      }
    }
  }

  // /////////////////////////////////////////////////////////////////////////////

  // Listado de errores del parser
  public ArrayList<String> synErrors = new ArrayList<>();
  private boolean errorRecovering = false;

  /**
  * Override for the report_error function to provide a better error message
  * @param msg
  * @param info
  */
  @Override
  public void report_error(String msg, Object info) {
    // Solo reportar si no estamos ya en modo de recuperación
    if (!errorRecovering) {
      Symbol s = (Symbol) info;
      synErrors.add("Línea " + s.left + ": " + msg);
    }
  }

  /**
  * Override for syntax_error function, which shouldn't be triggered considering
  * that the scanning process happened before this, but in some instances it was
  * triggered so we are just being cautious just in case we find one
  * @param cur_token
  */
  @Override
  public void syntax_error(Symbol cur_token) {
    // No reportar errores si ya estamos en modo de recuperación o si es un token ERROR
    if (cur_token.sym == sym.ERROR || errorRecovering)
      return;

    // Silenciar este error si ya tenemos errores reportados por las reglas de recuperación
    // Symbol s = cur_token;
    // addError("Línea " + s.left + ": Error de sintaxis");
  }


  /**
  * Override for unrecovered_syntax_error, which again shouldn't be triggered considering
  * that the scanning process happened before this, but in some instances it was
  * triggered so we are just being cautious just in case we find one
  * @param cur_token
  */
  @Override
  public void unrecovered_syntax_error(Symbol cur_token) throws java.lang.Exception {
    // Error fatal: no se pudo recuperar
    Symbol s = cur_token;
    addError("Línea " + s.left + ": Error fatal de sintaxis");
    // No lanzar excepción, solo reportar
    done_parsing();
  }

  /**
  * When a semantic error is found we will invoke the addError function to add it to the
  * list of semantic errors that we will display at the end of the compilation
  * @param error
  */
  public void addError(String error) {
    if (!synErrors.contains(error)) {
      synErrors.add(error);
    }
  }

  // Para ir acumulando los IDs de una declaración (a, b, c: INT;)
  public static class IdDecl {
    public String name;
    public int line;
    public IdDecl(String name, int line) {
      this.name = name;
      this.line = line;
    }
  }

  public java.util.List<IdDecl> tmpIdList = new java.util.ArrayList<>();

  // Para guardar el tipo actual (INT, REAL, STRING, CHAR)
  public String tmpType = null;
:};

// ====================== Terminals ====================== //
// In this section we have a list of all of the tokens from the lexer, which are provided as a sym obj
// we simply make a declaration of each terminal for token.

terminal PROGRAM, BEGIN, END, VAR, FUNCTION, PROCEDURE, IF, THEN, ELSE, WHILE, DO, FOR, TO, READ, WRITE;
terminal TINT, TREAL, TSTRING, TCHAR;
terminal ASSIGN, INC, DEC, PLUS, MINUS, TIMES, DIVIDE, MOD, INTDIV;
terminal EQ, GE, GT, LE, LT, NE, OR, AND, NOT;
terminal LPAREN, RPAREN, LBRACK, RBRACK, COMMA, SEMI, COLON, DOT, CARET;
terminal ID, INT_LIT, REAL_LIT, HEX_LIT, STR_LIT, CHAR_LIT, OCT_LIT;
terminal UMINUS;
terminal KEYWORD, ERROR;

// ==================== Non Terminals ==================== //
// In a similar fasion as before, here we declare syntax symbols, non terminals, that will build the productions.
// We define the LHS, the left productions and cup assigns the types and location in the parsing table

non terminal program, main_block, decls_opt, type_spec;
non terminal funcs_opt, func_list, func, proc, param_secs, param_sec, id_list, block;
non terminal stmt_list, stmt, expr, bExpr;
non terminal func_block, proc_block, return_stmt;
non terminal java.util.List args_opt, args_plus;
non terminal write_args, var_sections, var_sections_tail, decl_items, decl_item, decl_items_tail;

// ==================== Precedence Table ==================== //
// Denfies the order of max prior, it tells cup how to resolve conflicts, to know what operator has a higher
// priority, which to group when there's repetition, it helps avoids ambiguity

precedence left OR;
precedence left AND;
precedence nonassoc EQ, NE, LT, LE, GT, GE;
precedence left PLUS, MINUS;
precedence left TIMES, DIVIDE, MOD, INTDIV;
precedence left INC, DEC;
precedence right UMINUS;

// ================== Initial non terminal ================== //
// Tells cup which terminal we are going to use first

start with program;

// ==================== PROGRAM: Recuperación de errores a nivel principal ====================

//program ::= obliga a que el archivo empiece con la palabra PROGRAM, luego un nombre ID, y despúes el
//            bloque principal
//decls_opt = globales opcionales
//funcs_opt = funciones/procedimientos opcionales
//main_block ::= es el main que va en medio del BEGIN y END, y dentro debe haber un stmt_list, osea, la
//              lista de sentencias.
//stmt_list ::=  dentro de esta se hace una definición recursiva que significa una o más sentencias, osea
//              se toma la sentencia anterior, y se acumula la nueva.

program ::=
    PROGRAM ID decls_opt funcs_opt main_block
  | PROGRAM error:e decls_opt funcs_opt main_block
      {: parser.addError("Línea " + eleft + ": Error en la declaración del programa"); :}
  | error:e
      {: parser.addError("Línea " + eleft + ": Error en la declaración del programa"); :}
  ;

// ==================== MAIN BLOCK: Errores en el cuerpo principal ====================


main_block ::=
    BEGIN stmt_list END
  | BEGIN error:e END
      {: parser.addError("Línea " + eleft + ": Error en el bloque principal"); :}
  | BEGIN stmt_list error:e
      {: parser.addError("Línea " + eleft + ": Falta END en el bloque principal"); :}
  | error:e stmt_list END
      {: parser.addError("Línea " + eleft + ": Falta BEGIN en el bloque principal"); :}
  ;

stmt_list ::=
    stmt_list stmt
  | stmt
  ;

// ==================== VARIABLES GLOBALES: Errores en declaraciones ====================

//   Permite declarar variables globales ANTES del main.

//  Sintaxis soportada (estilo Pascal):
//     VAR a, b: INT;
//     VAR msg: STRING;

//  - `decls_opt` = sección de globales opcional
//  - `globals`   = 1..n declaraciones
//  - `decl`      = una declaración con lista de IDs y un tipo
//  - `id_list`   = a, b, c
//  - `type_spec` = TINT | TREAL | TSTRING | TCHAR



decls_opt ::= var_sections | /* vacío */ ;


var_sections ::=
    VAR decl_items var_sections_tail
  | VAR error:e SEMI var_sections_tail
      {: parser.addError("Línea " + eleft + ": Error en declaración de variable"); :}
  ;


var_sections_tail ::=
    VAR decl_items var_sections_tail
  | VAR error:e SEMI var_sections_tail
      {: parser.addError("Línea " + eleft + ": Error en declaración de variable"); :}
  | /* vacío */ ;


decl_items ::= decl_item decl_items_tail ;

decl_items_tail ::=
     decl_item decl_items_tail
  | /* vacío */ ;

decl_item ::=
    id_list COLON type_spec SEMI
    {:
        // Para cada ID declarado en esta línea...
        for (IdDecl idInfo : parser.tmpIdList) {
            String nombre = idInfo.name;
            int line = idInfo.line;

            // ¿Ya estaba declarada globalmente?
            if (CodeGenerator.getInstance().isVarDefined(nombre)) {
                parser.addSemanticError(
                    "Variable global '" + nombre + "' declarada más de una vez",
                    line
                );
            } else {
                // Primera vez → la guardamos como global
                CodeGenerator.getInstance().declararGlobal(nombre, parser.tmpType);
            }
        }

        // Limpiamos la lista y el tipo temporal
        parser.tmpIdList.clear();
        parser.tmpType = null;
    :}
  | id_list COLON type_spec error:e
      {: parser.addError("Línea " + eleft + ": Falta punto y coma"); :}
  | id_list error:e type_spec SEMI
      {: parser.addError("Línea " + eleft + ": Error en declaración de variable"); :}
  ;

id_list ::= id_list COMMA ID:id
      {:
        parser.tmpIdList.add(new IdDecl(id.toString(), idleft));
      :}
| ID:id  // ID: id guardar el valor del id para poder usarlo
      {:
          // Empezamos una nueva lista de IDs para esta declaración
          parser.tmpIdList.clear();
          parser.tmpIdList.add(new IdDecl(id.toString(), idleft));
      :} ;

// type_spec ::= TINT | TREAL | TSTRING | TCHAR ;
type_spec ::=
    TINT
      {:
          parser.tmpType = "INT";
      :}
  | TREAL
      {:
          parser.tmpType = "REAL";
      :}
  | TSTRING
      {:
          parser.tmpType = "STRING";
      :}
  | TCHAR
      {:
          parser.tmpType = "CHAR";
      :}
  ;

//================================================================================================================

// ==================== FUNCIONES Y PROCEDIMIENTOS ====================

//   Permite definir funciones y procedimientos ANTES del main.

//   Sintaxis soportada:
//   FUNCTION Suma(a, b: INT): INT;
//     BEGIN
//      Suma := a + b;
//     END

//     PROCEDURE Show(x: INT);
//     BEGIN
//       write(x);
//     END

//   - `funcs_opt`  = sección opcional
//   - `func_list`  = 1..n definiciones (func o proc)
//   - `func`       = FUNCTION ... : tipo ; block  |  PROCEDURE ... ; block
//   - `param_secs` = (a,b: INT; c: REAL) | vacío
//   - `param_sec`  = id_list : type_spec
//   - `block`      = BEGIN stmt_list END   (reutilizable)

return_stmt ::= ID ASSIGN expr SEMI ;

func_block ::= decls_opt BEGIN stmt_list return_stmt END ;
proc_block ::= decls_opt BEGIN stmt_list END ;

funcs_opt ::= func_list | /* vacío */ ;

func_list ::= func_list func | func_list proc | func | proc ;

func ::=
    FUNCTION ID:fname LPAREN param_secs RPAREN COLON type_spec SEMI func_block
      {:
        // false = es función (tiene tipo de retorno)
        parser.registerRoutine(fname, fnameleft, false, parser.tmpParamTypes);
        parser.tmpParamTypes.clear(); // dejar limpio para la siguiente rutina
      :}
  | FUNCTION error:e SEMI func_block
      {: parser.addError("Línea " + eleft + ": Error en declaración de función"); :}
  ;

proc ::=
    PROCEDURE ID:fname LPAREN param_secs RPAREN SEMI proc_block
    {:
        // true = es procedimiento (sin retorno)
        parser.registerRoutine(fname, fnameleft, true, parser.tmpParamTypes);
        parser.tmpParamTypes.clear();
    :}
  | PROCEDURE error:e SEMI proc_block
      {: parser.addError("Línea " + eleft + ": Error en declaración de procedimiento"); :}
  ;

param_secs ::= param_secs SEMI param_sec | param_sec | /* vacío */ ;

param_sec  ::=  id_list COLON type_spec
      {:
        // Por cada parámetro declarado aquí, agregamos su tipo a la lista temporal
        for (IdDecl idInfo : parser.tmpIdList) {
          parser.tmpParamTypes.add(parser.tmpType);
          // (si luego querés, aquí podrías registrar parámetros como variables locales)
        }
        parser.tmpIdList.clear();
        parser.tmpType = null;
      :} 
      ;

block ::=
    BEGIN stmt_list END
  | BEGIN error:e END
      {: parser.addError("Línea " + eleft + ": Error en bloque de código"); :}
  ;

//================================================================================================================

// ==================== SENTENCIAS: Recuperación detallada de errores ====================

// stmt ::=
//       ID ASSIGN expr SEMI
//     | READ SEMI
//     | WRITE LPAREN expr RPAREN SEMI
//     | IF bExpr THEN BEGIN stmt_list END
//     | WHILE bExpr DO BEGIN stmt_list END
//     | SEMI // vacío permisivo
//     ;

//   - Asignación:       x := <expr> ;
//   - Lectura         :   READ ;
//   - Escritura:        write(<expr>);
//   - IF:               IF <bExpr> THEN <bloque>
//   - WHILE:            WHILE <bExpr> DO <bloque>
//   - Vacía:            ;   (no-op; útil para tolerancia)

stmt ::=
    // Asignaciones
    ID:id ASSIGN expr SEMI {: parser.checkVarDefined(id, idleft); :}
  | ID:id ASSIGN bExpr SEMI {: parser.checkVarDefined(id, idleft); :}
  | ID ASSIGN expr error:e
      {: parser.addError("Línea " + eleft + ": Falta punto y coma"); :}
  | ID error:e expr SEMI
      {: parser.addError("Línea " + eleft + ": Error en asignación"); :}

  // READ
  | READ SEMI
  | READ LPAREN expr RPAREN SEMI
  | READ error:e
      {: parser.addError("Línea " + eleft + ": Error en READ"); :}

  // WRITE
  | WRITE LPAREN write_args RPAREN SEMI
  | WRITE LPAREN write_args RPAREN error:e
      {: parser.addError("Línea " + eleft + ": Falta punto y coma"); :}
  | WRITE error:e SEMI
      {: parser.addError("Línea " + eleft + ": Error en WRITE"); :}

  // Llamadas a funciones/procedimientos
  | ID:fname LPAREN args_opt:args RPAREN SEMI
      {:
        parser.checkRoutineDefined(fname, args, fnameleft);
      :}
  | ID:fname LPAREN args_opt:args RPAREN error:e
      {:
        parser.checkRoutineDefined(fname, args, fnameleft);
        parser.addError("Línea " + eleft + ": Falta punto y coma");
      :}

  // IF statements
  | IF bExpr THEN block
  | IF bExpr THEN block ELSE block
  | IF bExpr error:e block
      {: parser.addError("Línea " + eleft + ": Error en IF"); :}
  | IF error:e THEN block
      {: parser.addError("Línea " + eleft + ": Error en IF"); :}
  | IF bExpr ID:i block
      {: parser.addError("Línea " + ileft + ": Error en IF"); :}
  | IF bExpr ELSE block
      {: parser.addError("Error en IF"); :}

  // WHILE statements
  | WHILE bExpr DO block
  | WHILE bExpr error:e block
      {: parser.addError("Línea " + eleft + ": Error en WHILE"); :}
  | WHILE error:e DO block
      {: parser.addError("Línea " + eleft + ": Error en WHILE"); :}
  | WHILE bExpr ID:i block
      {: parser.addError("Línea " + ileft + ": Error en WHILE"); :}

  // FOR statements
  | FOR ID ASSIGN expr TO expr DO block
  | FOR ID ASSIGN expr TO expr error:e block
      {: parser.addError("Línea " + eleft + ": Error en FOR"); :}
  | FOR error:e DO block
      {: parser.addError("Línea " + eleft + ": Error en FOR"); :}
  | FOR ID ASSIGN expr TO expr ID:i block
      {: parser.addError("Línea " + ileft + ": Error en FOR"); :}

  // Sentencia vacía
  | SEMI

  // Error genérico con recuperación hasta el siguiente punto y coma
  | error:e SEMI
      {: parser.addError("Línea " + eleft + ": Error de sintaxis"); :}

  // Recuperación específica para token ERROR (devuelto por el scanner)
  | ERROR:lex SEMI
      {: parser.addError("Línea " + ((Symbol)lex).left + ": Error léxico"); :}

  ;

//================================================================================================================

args_opt ::=
    /* vacío */
      {:
        RESULT = new java.util.ArrayList();
      :}
  | args_plus:list
      {:
         RESULT = list;
      :}
  ;

args_plus ::=
    expr:e
      {:
        java.util.List list = new java.util.ArrayList();
        list.add(e);   // e es el "tipo" devuelto por expr (INT, REAL, etc.)
        RESULT = list;
      :}
  | args_plus:prev COMMA expr:e
      {:
        prev.add(e);   // ahora prev es java.util.List, ya no Object
        RESULT = prev;
      :}
  ;

write_args ::=
    expr
  | write_args COMMA expr
  ;

//================================================================================================================

// ==================== EXPRESIONES BOOLEANAS (SIN conflictos) ====================



bExpr ::=
    expr EQ expr
  | expr NE expr
  | expr LT expr
  | expr LE expr
  | expr GT expr
  | expr GE expr
  | bExpr OR bExpr
  | bExpr AND bExpr
  | NOT bExpr
  | LPAREN bExpr RPAREN
  ;

//================================================================================================================

// ==================== EXPRESIONES ARITMÉTICAS (SIN conflictos) ====================

expr ::=
    expr PLUS expr
      {: RESULT = TYPE_UNKNOWN; :}
  | expr MINUS expr
      {: RESULT = TYPE_UNKNOWN; :}
  | expr TIMES expr
      {: RESULT = TYPE_UNKNOWN; :}
  | expr DIVIDE expr
      {: RESULT = TYPE_UNKNOWN; :}
  | expr MOD expr
      {: RESULT = TYPE_UNKNOWN; :}
  | expr INTDIV expr
      {: RESULT = TYPE_UNKNOWN; :}
  | MINUS expr:e
      {: RESULT = TYPE_UNKNOWN; :} %prec UMINUS

  // Literales
  | INT_LIT
      {: RESULT = TYPE_INT; :}
  | REAL_LIT
      {: RESULT = TYPE_REAL; :}
  | HEX_LIT
      {: RESULT = TYPE_INT; :}
  | STR_LIT
      {: RESULT = TYPE_STRING; :}
  | CHAR_LIT
      {: RESULT = TYPE_CHAR; :}

  // Identificadores (variables globales)
  | ID:id
      {:
        parser.checkVarDefined(id, idleft);
        RESULT = parser.getIdType(id);
      :}

  | LPAREN expr:e RPAREN
      {: RESULT = e; :}

  // Llamadas a funciones/procedimientos usadas en expresiones
  | ID:fname LPAREN args_opt:args RPAREN
      {:
        parser.checkRoutineDefined(fname, args, fnameleft);
        RESULT = TYPE_UNKNOWN;   // por ahora no inferimos tipo de retorno
      :}

  | expr:e INC
      {: RESULT = TYPE_UNKNOWN; :}
  | expr:e DEC
      {: RESULT = TYPE_UNKNOWN; :}

  // Recuperación para ERROR léxico
  | ERROR:lex
      {:
        parser.addError("Línea " + ((Symbol)lex).left + ": Error léxico");
        RESULT = TYPE_UNKNOWN;
      :}
  ;